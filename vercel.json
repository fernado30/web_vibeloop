{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "echo skip",
  "buildCommand": "node apps/web/build.mjs",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/open/:code",
      "destination": "/buzon/index.html"
    },
    {
      "source": "/join/:code",
      "destination": "/buzon/index.html"
    },
    {
      "source": "/invite/:code",
      "destination": "/buzon/index.html"
    },
    {
      "source": "/buzon/:code",
      "destination": "/buzon/index.html"
    }
  ]
}
