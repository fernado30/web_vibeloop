# Local backend server
PORT=8787
ALLOWED_ORIGINS=https://web-nadie.vercel.app,http://localhost:3000,http://localhost:4173,http://localhost:8080

# Supabase project
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
BACKEND_INTERNAL_KEY=YOUR_RANDOM_INTERNAL_KEY

# Optional: used when the backend proxies legacy Supabase edge functions
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n
